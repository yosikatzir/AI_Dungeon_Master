# OpenAI API key. Used server-side only — never sent to the client. Only
# needed for image generation (lib/ai/images.ts) — chat/summarization run on
# Bedrock, voice transcription on Amazon Transcribe.
OPENAI_API_KEY=sk-...

# Random string (32+ hex chars recommended) used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# AWS region for Bedrock/Transcribe/S3 calls. Defaults to us-east-1 if unset.
AWS_REGION=us-east-1

# Local development only — picks up credentials from ~/.aws (the `personal`
# profile). Not needed in production; the EC2 instance uses its IAM role.
AWS_PROFILE=personal
