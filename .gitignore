# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# secrets kept alongside the project (not part of the app)
API_Key.txt

# vercel
.vercel

# claude code local permission settings (per-developer, not shared)
.claude/settings.local.json

# typescript
*.tsbuildinfo

# app data (runtime, not source)
/data/app.db
/data/app.db-*
/data/images/*
!/data/images/.gitkeep
!/data/.gitkeep

# test/coverage
/coverage

# terraform (state and tfvars carry account-specific/local details; the lock
# file is tracked on purpose, like a package-lock.json for providers).
# infra/ itself uses a remote S3 backend, but infra/bootstrap/ deliberately
# keeps local state (it creates the bucket infra/ then stores state in), so
# these patterns cover both.
/infra/**/.terraform/
/infra/**/terraform.tfstate
/infra/**/terraform.tfstate.*
/infra/**/*.tfvars
/infra/**/*.tfplan
